    local _toggleRegistry = {}
    local CONFIG_FILE = "FreedomVS.json"

    local function loadConfig()
        local existsOk, exists = pcall(isfile, CONFIG_FILE)
        if not existsOk or not exists then return {} end
        local ok, raw = pcall(readfile, CONFIG_FILE)
        if not ok or not raw or raw == "" then return {} end
        local ok2, data = pcall(function() return HS:JSONDecode(raw) end)
        return (ok2 and type(data) == "table") and data or {}
    end

    local function saveConfigNow(state)
        local ok, encoded = pcall(function() return HS:JSONEncode(state) end)
        if not ok or not encoded then return end
        pcall(writefile, CONFIG_FILE, encoded)
    end

    local _configState = loadConfig()
    if _configState["menuBackground"] and _FREEDOMVS._setMenuBackground then
        _FREEDOMVS._setMenuBackground(_configState["menuBackground"])
    end
    local _configSaveTimer = nil
    local function _autoSaveConfig()
        if _configSaveTimer then task.cancel(_configSaveTimer) end
        _configSaveTimer = task.delay(0.5, function()
            saveConfigNow(_configState)
        end)
    end

    local function _regToggle(parent, label, startOn, order, key, onToggle)
        local row, rawSetState = toggleRow(parent, label, startOn, order, function(on)
            _configState[key] = on
            if onToggle then onToggle(on) end
            _autoSaveConfig()
        end)
        local function setState(on, animate)
            rawSetState(on, animate)
        end
        table.insert(_toggleRegistry, {setState = setState, key = key, callback = onToggle})
        return row, setState
    end

    local function _regToggleOnly(key, startOn, onToggle)
        local setState
        setState = function(on)
            _configState[key] = on
            if onToggle then onToggle(on) end
            _autoSaveConfig()
        end
        table.insert(_toggleRegistry, {setState = setState, key = key, callback = onToggle})
        setState(startOn)
    end

    local function _regAction(key, label, actionFn)
        _FREEDOMVS._actionRegistry[key] = {label = label, fn = actionFn}
    end

    _FREEDOMVS._syncToggleOff = function(key)
        _configState[key] = false
        for _, e in ipairs(_toggleRegistry) do
            if e.key == key then e.setState(false); break end
        end
        if key == "AUTOLEFT" and _FREEDOMVS._setALOn then _FREEDOMVS._setALOn(false, true) end
        if key == "AUTORIGHT" and _FREEDOMVS._setAROn then _FREEDOMVS._setAROn(false, true) end
        if key == "AUTOBAT" and _FREEDOMVS._setABOn then _FREEDOMVS._setABOn(false, true) end
        if key == "TPBAT" and _FREEDOMVS._setTPBOn then _FREEDOMVS._setTPBOn(false, true) end
        if key == "CARRYSPEED" and _FREEDOMVS._setCarryFB then _FREEDOMVS._setCarryFB(false, true) end
        if key == "LAGGERSPEED" and _FREEDOMVS._setLaggerFB then _FREEDOMVS._setLaggerFB(false, true) end
        if key == "LAGGER_CARRY" and _FREEDOMVS._setLagFB then _FREEDOMVS._setLagFB(false, true) end
        if key == "AUTO_STEAL" then
            autoStealEnabled = false
            if _G.AdaptAutoStealSync then _G.AdaptAutoStealSync() end
        end
        _autoSaveConfig()
    end

