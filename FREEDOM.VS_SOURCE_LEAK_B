        screenGui.DisplayOrder = 9999
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = playerGui
        E01_CurrentUI = screenGui

        local frame = Instance.new("Frame")
        frame.Name = "WarningFrame"
        frame.Size = UDim2.new(0, 500, 0, 80)
        frame.Position = UDim2.new(0.5, -250, 0, 30)
        frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        frame.BackgroundTransparency = 0.3
        frame.BorderSizePixel = 0
        frame.ClipsDescendants = true
        frame.ZIndex = 20
        frame.Parent = screenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 16)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Name = "WarningStroke"
        stroke.Color = Color3.fromRGB(255, 0, 0)
        stroke.Thickness = 3
        stroke.Transparency = 0.3
        stroke.Parent = frame

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "MainText"
        textLabel.Size = UDim2.new(1, -20, 0, 40)
        textLabel.Position = UDim2.new(0, 10, 0, 5)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.TextSize = 18
        textLabel.TextXAlignment = Enum.TextXAlignment.Center
        textLabel.TextWrapped = true
        textLabel.ZIndex = 21
        textLabel.Text = "🚫 Dont go in their base now while stealing or you will get kicked by E01"
        textLabel.Parent = frame

        local subText = Instance.new("TextLabel")
        subText.Name = "Countdown"
        subText.Size = UDim2.new(1, -20, 0, 20)
        subText.Position = UDim2.new(0, 10, 0, 48)
        subText.BackgroundTransparency = 1
        subText.TextColor3 = Color3.fromRGB(255, 200, 0)
        subText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        subText.TextStrokeTransparency = 0
        subText.Font = Enum.Font.SourceSans
        subText.TextSize = 14
        subText.TextXAlignment = Enum.TextXAlignment.Center
        subText.ZIndex = 21
        subText.Text = "⏳ 3.00 SECONDS REMAINING"
        subText.Parent = frame

        -- Inset progress track: keeps the line away from the rounded capsule edges.
        local progressTrack = Instance.new("Frame")
        progressTrack.Name = "ProgressTrack"
        progressTrack.AnchorPoint = Vector2.new(0.5, 1)
        progressTrack.Position = UDim2.new(0.5, 0, 1, -3)
        progressTrack.Size = UDim2.new(1, -10, 0, 3)
        progressTrack.BackgroundTransparency = 1
        progressTrack.BorderSizePixel = 0
        progressTrack.ClipsDescendants = true
        progressTrack.ZIndex = 22
        progressTrack.Parent = frame

        local progressBar = Instance.new("Frame")
        progressBar.Name = "ProgressBar"
        progressBar.Size = UDim2.new(0, 0, 1, 0)
        progressBar.Position = UDim2.new(0, 0, 0, 0)
        progressBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        progressBar.BorderSizePixel = 0
        progressBar.ZIndex = 23
        progressBar.Parent = progressTrack

        local progressCorner = Instance.new("UICorner")
        progressCorner.CornerRadius = UDim.new(1, 0)
        progressCorner.Parent = progressBar

        local duration = 3.0
        local startTime = time()
        local finished = false
        local connection

        connection = E01_RunService.RenderStepped:Connect(function()
            if finished or token ~= E01_ACTIVE_TOKEN or not frame.Parent then
                if connection then
                    connection:Disconnect()
                    connection = nil
                end
                return
            end

            local elapsed = time() - startTime
            local remaining = math.max(0, duration - elapsed)
            local progress = math.clamp(elapsed / duration, 0, 1)

            progressBar.Size = UDim2.new(math.clamp(progress, 0, 1), 0, 1, 0)

            if progress < 0.33 then
                progressBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                stroke.Color = Color3.fromRGB(255, 0, 0)
            elseif progress < 0.66 then
                progressBar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                stroke.Color = Color3.fromRGB(255, 200, 0)
            else
                progressBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                stroke.Color = Color3.fromRGB(0, 255, 100)
            end

            if remaining > 0 then
                subText.Text = string.format("⏳ %.2f SECONDS REMAINING", remaining)
            else
                finished = true

                if connection then
                    connection:Disconnect()
                    connection = nil
                end

                textLabel.Text = "✅ You can now steal the brainrot without getting kicked"
                textLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                subText.Text = "⚡ STEAL NOW! ⚡"
                subText.TextColor3 = Color3.fromRGB(0, 255, 100)
                stroke.Color = Color3.fromRGB(0, 255, 100)
                progressBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                progressBar.Size = UDim2.new(1, 0, 1, 0)

                local bounce = E01_TweenService:Create(
                    frame,
                    TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                    {Size = UDim2.new(0, 520, 0, 85)}
                )
                bounce:Play()

                task.delay(0.3, function()
                    if token ~= E01_ACTIVE_TOKEN or not frame.Parent then return end
                    E01_TweenService:Create(
                        frame,
                        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        {Size = UDim2.new(0, 500, 0, 80)}
                    ):Play()
                end)

                task.delay(3.3, function()
                    if token ~= E01_ACTIVE_TOKEN then return end
                    if screenGui and screenGui.Parent then
                        screenGui:Destroy()
                    end
                    if E01_CurrentUI == screenGui then
                        E01_CurrentUI = nil
                    end
                end)
            end
        end)
    end

    task.spawn(function()
        while task.wait(0.1) do
            local currentlyCarrying = E01_isCarrying()

            if not E01_WAS_CARRYING and currentlyCarrying then
                E01_startWarning()
            end

            E01_WAS_CARRYING = currentlyCarrying
        end
    end)
end
