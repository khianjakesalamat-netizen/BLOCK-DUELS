    _FREEDOMVS.B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    _FREEDOMVS.setFontUI = nil

    function _FREEDOMVS.encode(s)
        local r, pad = {}, ""
        local n = #s % 3
        if n > 0 then s = s .. string.rep("\0", 3 - n); pad = string.rep("=", 3 - n) end
        for i = 1, #s, 3 do
            local a, b, c = string.byte(s, i, i + 2)
            local v = bit32.bor(bit32.lshift(a, 16), bit32.lshift(b, 8), c)
            r[#r+1] = _FREEDOMVS.B64:sub(bit32.rshift(v, 18) + 1, bit32.rshift(v, 18) + 1)
            r[#r+1] = _FREEDOMVS.B64:sub(bit32.band(bit32.rshift(v, 12), 63) + 1, bit32.band(bit32.rshift(v, 12), 63) + 1)
            r[#r+1] = _FREEDOMVS.B64:sub(bit32.band(bit32.rshift(v, 6), 63) + 1, bit32.band(bit32.rshift(v, 6), 63) + 1)
            r[#r+1] = _FREEDOMVS.B64:sub(bit32.band(v, 63) + 1, bit32.band(v, 63) + 1)
        end
        local out = table.concat(r)
        return out:sub(1, #out - #pad) .. pad
    end

    function _FREEDOMVS.decode(s)
        local t = {}
        for i = 1, #_FREEDOMVS.B64 do t[_FREEDOMVS.B64:sub(i, i)] = i - 1 end
        s = s:gsub("[^A-Za-z0-9+/=]", "")
        local r = {}
        for i = 1, #s, 4 do
            local a = t[s:sub(i, i )] or 0
            local b = t[s:sub(i+1, i+1)] or 0
            local c = t[s:sub(i+2, i+2)] or 0
            local d = t[s:sub(i+3, i+3)] or 0
            local v = bit32.bor(bit32.lshift(a, 18), bit32.lshift(b, 12), bit32.lshift(c, 6), d)
            r[#r+1] = string.char(bit32.rshift(v, 16))
            if s:sub(i+2, i+2) ~= "=" then r[#r+1] = string.char(bit32.band(bit32.rshift(v, 8), 0xFF)) end
            if s:sub(i+3, i+3) ~= "=" then r[#r+1] = string.char(bit32.band(v, 0xFF)) end
        end
        return table.concat(r)
    end

