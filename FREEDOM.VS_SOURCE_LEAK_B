    RunService.RenderStepped:Connect(function(dt)
        local t = tick()
        for i = #_rotatingBorderRegistry, 1, -1 do
            local item = _rotatingBorderRegistry[i]
            if not item.button or not item.button.Parent
               or not item.gradient or not item.gradient.Parent
               or not item.stroke or not item.stroke.Parent then
                table.remove(_rotatingBorderRegistry, i)
            else
                item.gradient.Rotation = (item.gradient.Rotation + item.speed * dt) % 360
                local breathe = (math.sin(t * 2.0) * 0.5 + 0.5)
                item.stroke.Thickness = item.baseThickness + (breathe * 0.5)
                item.stroke.Transparency = math.max(0, item.baseTransparency - (breathe * 0.12))
            end
        end
    end)

