    local function _makeBorderColorSequence(theme)
        local c = theme.colors
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, c[1]),
            ColorSequenceKeypoint.new(0.20, c[2]),
            ColorSequenceKeypoint.new(0.35, c[3]),
            ColorSequenceKeypoint.new(0.50, c[4]),
            ColorSequenceKeypoint.new(0.65, c[5]),
            ColorSequenceKeypoint.new(0.80, c[6]),
            ColorSequenceKeypoint.new(1.00, c[7]),
        })
    end

    local function _applyBorderLineTheme(idx)
        idx = math.clamp(tonumber(idx) or 1, 1, #_borderLineThemes)
        _borderLineTheme = idx
        local theme = _borderLineThemes[idx]
        for i = #_rotatingBorderRegistry, 1, -1 do
            local item = _rotatingBorderRegistry[i]
            if item.gradient and item.gradient.Parent then
                item.gradient.Color = _makeBorderColorSequence(theme)
            else
                table.remove(_rotatingBorderRegistry, i)
            end
        end
        return true
    end

