-- ============================================================
-- Standalone Steal Bar (Responsive + FPS/Ping + Drag + Radius)
-- ============================================================
do
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local CoreGui = game:GetService("CoreGui")
    local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local gethui = gethui or function() return CoreGui end

    local UIS = UserInputService
    local TS  = TweenService
    local LP  = Players.LocalPlayer

    -- Cleanup old instances
    local existing = PlayerGui:FindFirstChild("AdaptStealBarStandalone")
    if existing then existing:Destroy() end
    local inCore = CoreGui:FindFirstChild("AdaptStealBarStandalone")
    if inCore then inCore:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "AdaptStealBarStandalone"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = gethui() or PlayerGui

    -- ---------- Responsive size + user-adjustable Steal Bar Size ----------
    local function getSavedStealBarSize()
        local ok, raw = pcall(function()
            if isfile and isfile("FreedomVS.json") then
                return readfile("FreedomVS.json")
            end
        end)
        if ok and raw and raw ~= "" then
            local ok2, data = pcall(function()
                return game:GetService("HttpService"):JSONDecode(raw)
            end)
            if ok2 and type(data) == "table" then
                local v = tonumber(data["stealBarSize"])
                if v then return math.clamp(math.floor(v), 50, 150) end
            end
        end
        return 100
    end

    local stealBarSizePercent = getSavedStealBarSize()

    local function getResponsiveStealBarSize()
        local cam = workspace.CurrentCamera
        local viewport = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
        local w, h
        if isMobile then
            w = math.clamp(math.floor(viewport.X * 0.48 + 0.5), 170, 300)
            h = math.clamp(math.floor(viewport.Y * 0.07 + 0.5), 52, 68)
        else
            w = math.clamp(math.floor(viewport.X * 0.32 + 0.5), 220, 420)
            h = math.clamp(math.floor(viewport.Y * 0.085 + 0.5), 54, 80)
        end

        local scale = stealBarSizePercent / 100
        w = math.floor(w * scale + 0.5)
        h = math.floor(h * scale + 0.5)
        return w, h
    end

    local stealBarWidth, stealBarHeight = getResponsiveStealBarSize()

    local pbFrame = Instance.new("Frame", gui)
    pbFrame.Name = "StealBar"
    pbFrame.Size = UDim2.new(0, stealBarWidth, 0, stealBarHeight)
    pbFrame.Position = UDim2.new(0.5, -math.floor(stealBarWidth / 2), 1, -(stealBarHeight + 18))
    pbFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    pbFrame.BorderSizePixel = 0
    pbFrame.Active = true
    pbFrame.ClipsDescendants = true
    pbFrame.ZIndex = 10
    Instance.new("UICorner", pbFrame).CornerRadius = UDim.new(0, 15)

    local pbStroke = Instance.new("UIStroke", pbFrame)
    pbStroke.Name = "StealBarStroke"
    pbStroke.Color = Color3.fromRGB(55, 55, 55)
    pbStroke.Thickness = 1

    local stealWhiteGlow = Instance.new("Frame", pbFrame)
    stealWhiteGlow.Name = "StealWhiteGlow"
    stealWhiteGlow.Size = UDim2.new(1, 0, 1, 0)
    stealWhiteGlow.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    stealWhiteGlow.BackgroundTransparency = 1
    stealWhiteGlow.BorderSizePixel = 0
    stealWhiteGlow.ZIndex = 11
    stealWhiteGlow.Active = false
    Instance.new("UICorner", stealWhiteGlow).CornerRadius = UDim.new(0, 15)

    local glowGradient = Instance.new("UIGradient", stealWhiteGlow)
    glowGradient.Rotation = 90
    glowGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.55),
        NumberSequenceKeypoint.new(0.45, 0.15),
        NumberSequenceKeypoint.new(1, 0.65),
    })

    if _G.AdaptStealBarSetSize then
        _G.AdaptStealBarSetSize(stealBarSizePercent)
    end

    local progressPct = Instance.new("TextLabel", pbFrame)
    progressPct.Size = UDim2.new(0, 64, 0, 18)
    progressPct.Position = UDim2.new(0, 10, 0, 3)
    progressPct.BackgroundTransparency = 1
    progressPct.Text = "0%"
    progressPct.TextColor3 = Color3.fromRGB(255, 255, 255)
    progressPct.Font = Enum.Font.FredokaOne
    progressPct.TextSize = 14
    progressPct.TextXAlignment = Enum.TextXAlignment.Left
    progressPct.ZIndex = 14

    local progressStatus = Instance.new("TextLabel", pbFrame)
    progressStatus.Name = "ProgressStatus"
    progressStatus.Size = UDim2.new(0, 165, 0, 18)
    progressStatus.Position = UDim2.new(1, -175, 0, 4)
    progressStatus.BackgroundTransparency = 1
    progressStatus.Text = "FPS 60  PING 0ms  R:63"
    progressStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
    progressStatus.Font = Enum.Font.FredokaOne
    progressStatus.TextSize = 11
    progressStatus.TextXAlignment = Enum.TextXAlignment.Right
    progressStatus.ZIndex = 14

    local fillRegion = Instance.new("Frame", pbFrame)
    fillRegion.Name = "ProgressBackground"
    fillRegion.Size = UDim2.new(1, -18, 0, 18)
    fillRegion.Position = UDim2.new(0, 9, 1, -21)
    fillRegion.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    fillRegion.BackgroundTransparency = 0.85
    fillRegion.BorderSizePixel = 0
    fillRegion.ClipsDescendants = true
    fillRegion.ZIndex = 12
    Instance.new("UICorner", fillRegion).CornerRadius = UDim.new(1, 0)

    local fillStroke = Instance.new("UIStroke", fillRegion)
    fillStroke.Color = Color3.fromRGB(255, 255, 255)
    fillStroke.Transparency = 0.65
    fillStroke.Thickness = 1

    local progressFill = Instance.new("Frame", fillRegion)
    progressFill.Name = "Fill"
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    progressFill.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
    progressFill.BackgroundTransparency = 0.12
    progressFill.BorderSizePixel = 0
    progressFill.ZIndex = 13
    Instance.new("UICorner", progressFill).CornerRadius = UDim.new(1, 0)

    local progressFillGrad = Instance.new("UIGradient", progressFill)
    progressFillGrad.Rotation = 90
    progressFillGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(0.45, 0.35),
        NumberSequenceKeypoint.new(1, 0.05),
    })

    local progressShine = Instance.new("Frame", progressFill)
    progressShine.Name = "Shine"
    progressShine.Size = UDim2.new(1, 0, 0, 2)
    progressShine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    progressShine.BackgroundTransparency = 0.35
    progressShine.BorderSizePixel = 0
    progressShine.ZIndex = 14
    Instance.new("UICorner", progressShine).CornerRadius = UDim.new(1, 0)

    -- ---------- State ----------
    local barState = "IDLE"
    local function setBarState(state)
        barState = state
        if state == "STEALING" then
            TS:Create(pbStroke, TweenInfo.new(0.22), {
                Color = Color3.fromRGB(255, 255, 255),
                Transparency = 0.05,
                Thickness = 1.6,
            }):Play()
            TS:Create(stealWhiteGlow, TweenInfo.new(0.28, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.72,
            }):Play()
        elseif state == "READY" then
            TS:Create(pbStroke, TweenInfo.new(0.25), {
                Color = Color3.fromRGB(90, 90, 90),
                Transparency = 0,
                Thickness = 1,
            }):Play()
            TS:Create(stealWhiteGlow, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        else
            TS:Create(pbStroke, TweenInfo.new(0.25), {
                Color = Color3.fromRGB(55, 55, 55),
                Transparency = 0,
                Thickness = 1,
            }):Play()
            TS:Create(stealWhiteGlow, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        end
    end

    -- ---------- Auto-resize on viewport change ----------
    local function refreshResponsiveStealBar()
        if not pbFrame or not pbFrame.Parent then return end
        stealBarWidth, stealBarHeight = getResponsiveStealBarSize()
        pbFrame.Size = UDim2.new(0, stealBarWidth, 0, stealBarHeight)
        pbFrame.Position = UDim2.new(
            pbFrame.Position.X.Scale,
            pbFrame.Position.X.Offset,
            pbFrame.Position.Y.Scale,
            pbFrame.Position.Y.Offset
        )
    end

    _G.AdaptStealBarSetSize = function(percent)
        percent = math.clamp(math.floor(tonumber(percent) or 100), 50, 150)
        stealBarSizePercent = percent
        refreshResponsiveStealBar()

        -- Keep the bar centered when its width changes and it is still using
        -- the default centered position.
        if pbFrame and pbFrame.Parent then
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
            local centeredX = math.floor(vp.X / 2 - stealBarWidth / 2)
            if math.abs(pbFrame.Position.X.Offset - centeredX) < 20
                or pbFrame.Position.X.Scale == 0.5 then
                pbFrame.Position = UDim2.new(0.5, -math.floor(stealBarWidth / 2), pbFrame.Position.Y.Scale, pbFrame.Position.Y.Offset)
            end
        end
    end

    task.defer(refreshResponsiveStealBar)
    if workspace.CurrentCamera then
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshResponsiveStealBar)
    end

    -- ---------- Global API (same names as before) ----------
    _G.AdaptStealBarSetProgress = function(p)
        p = math.clamp(tonumber(p) or 0, 0, 1)
        if progressFill then progressFill.Size = UDim2.new(p, 0, 1, 0) end
        if progressPct then progressPct.Text = math.floor(p * 100 + 0.5) .. "%" end
        if barState == "STEALING" then
            stealWhiteGlow.BackgroundTransparency = 0.84 - (p * 0.26)
            progressFill.BackgroundTransparency = 0.18 - (p * 0.12)
            pbStroke.Transparency = math.max(0.02, 0.18 - (p * 0.16))
        end
    end
    _G.AdaptStealBarSetState = setBarState
    _G.AdaptStealBarReset = function()
        _G.AdaptStealBarSetProgress(0)
        setBarState("IDLE")
    end

    -- ---------- Drag (respects LOCK BUTTONS toggle) ----------
    local dragHandle = Instance.new("TextButton", pbFrame)
    dragHandle.Name = "DragHandle"
    dragHandle.Size = UDim2.new(1, 0, 1, 0)
    dragHandle.BackgroundTransparency = 1
    dragHandle.BorderSizePixel = 0
    dragHandle.Text = ""
    dragHandle.AutoButtonColor = false
    dragHandle.Active = true
    dragHandle.Selectable = false
    dragHandle.ZIndex = 30

    do
        local dragging, dragStartPos, barStartPos, dragInput
        dragHandle.InputBegan:Connect(function(input)
            if _G._FREEDOMVS and _G._FREEDOMVS._dragLockedFn and _G._FREEDOMVS._dragLockedFn() then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStartPos = input.Position
                barStartPos = pbFrame.Position
            end
        end)
        dragHandle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input == dragInput then
                local delta = input.Position - dragStartPos
                pbFrame.Position = UDim2.new(
                    barStartPos.X.Scale, barStartPos.X.Offset + delta.X,
                    barStartPos.Y.Scale, barStartPos.Y.Offset + delta.Y
                )
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                dragInput = nil
            end
        end)
    end

    setBarState("IDLE")

    -- ---------- FPS / Ping / Radius updater ----------
    task.spawn(function()
        local lastFrame = tick()
        local fpsSamples = {}
        local fpsAvg = 60

        RunService.RenderStepped:Connect(function()
            local now = tick()
            local dt = now - lastFrame
            lastFrame = now
            if dt > 0 then
                table.insert(fpsSamples, 1 / dt)
                if #fpsSamples > 30 then table.remove(fpsSamples, 1) end
                local sum = 0
                for _, v in ipairs(fpsSamples) do sum = sum + v end
                fpsAvg = sum / #fpsSamples
            end
        end)

        while gui and gui.Parent do
            local ping = 0
            pcall(function() ping = LP:GetNetworkPing() * 1000 end)

            local radius = 63
            pcall(function()
                if _G.AdaptGalaxyV3 and _G.AdaptGalaxyV3.StealRadius then
                    radius = _G.AdaptGalaxyV3.StealRadius
                end
            end)

            if progressStatus then
                progressStatus.Text = string.format(
                    "FPS %d  PING %dms  R:%d",
                    math.floor(fpsAvg + 0.5),
                    math.floor(ping + 0.5),
                    math.floor(radius + 0.5)
                )
            end
            task.wait(0.5)
        end
    end)
end